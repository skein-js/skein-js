{
  "name": "console-ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/console/ui/src",
  "projectType": "application",
  "tags": [],
  "// targets": "build / serve / preview / test are inferred by @nx/vite from vite.config.mts; lint by @nx/eslint. `nx serve console-ui` is the HMR dev loop; `nx build console-ui` produces the static bundle @skein-js/console compiles in.",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "packages/console/ui"
      },
      "dependsOn": ["typecheck-browser"]
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "console:build",
        "server-express:build",
        "langgraph:build",
        "storage-memory:build"
      ],
      "options": {
        "command": "vitest run --config vitest.browser.config.ts",
        "cwd": "packages/console/ui"
      }
    },
    "typecheck-browser": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "console:build",
        "server-express:build",
        "langgraph:build",
        "storage-memory:build"
      ],
      "options": {
        "command": "tsc --noEmit -p tsconfig.browser.json",
        "cwd": "packages/console/ui"
      }
    }
  }
}
