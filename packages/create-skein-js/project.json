{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "create-skein-js",
  "sourceRoot": "packages/create-skein-js/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup --config tsup.config.ts",
        "cwd": "packages/create-skein-js"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/create-skein-js"
      }
    },
    "generate-templates": {
      "executor": "nx:run-commands",
      "dependsOn": ["scaffold:generate-templates"],
      "options": {
        "command": "node -e \"void 0\""
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/examples/express-basic/package.json",
        "{workspaceRoot}/package.json"
      ],
      "dependsOn": ["build"]
    }
  }
}
