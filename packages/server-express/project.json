{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server-express",
  "sourceRoot": "packages/server-express/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup src/index.ts --format esm --dts --clean",
        "cwd": "packages/server-express"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/server-express"
      },
      "dependsOn": ["^build", "typecheck-browser"]
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.integration.config.ts",
        "cwd": "packages/server-express"
      }
    },
    "test-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "command": "vitest run --config vitest.browser.config.ts",
        "cwd": "packages/server-express"
      }
    },
    "typecheck-browser": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit -p tsconfig.browser.json",
        "cwd": "packages/server-express"
      }
    },
    "prepare-browser": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm exec playwright install --with-deps chromium",
        "cwd": "packages/server-express"
      }
    }
  }
}
