{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bench",
  "sourceRoot": "packages/bench/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup",
        "cwd": "packages/bench"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/bench"
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node --expose-gc dist/main.js",
        "cwd": "packages/bench"
      }
    }
  }
}
