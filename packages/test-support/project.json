{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "test-support",
  "sourceRoot": "packages/test-support/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/test-support"
      }
    },
    "test": {
      "dependsOn": [
        "^build",
        "server-express:build",
        "server-fastify:build",
        "server-nestjs:build",
        "server-nextjs:build",
        "server-fetch:build",
        "local:build",
        "storage-sqlite:build"
      ],
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/packages/agent-protocol/src/validation/schemas.ts",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/patches/**/*",
        "{workspaceRoot}/scripts/pack-local-consumer.mjs",
        "{workspaceRoot}/packages/local/src/**/*",
        "{workspaceRoot}/packages/storage-sqlite/src/**/*",
        "{workspaceRoot}/packages/langgraph/src/**/*"
      ]
    },
    "test-local-consumer": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["local:build", "storage-sqlite:build", "cli:build", "create-skein-js:build"],
      "options": {
        "command": "node scripts/local-consumer-smoke.mjs",
        "cwd": "."
      }
    },
    "test-native-consumer": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["local:build", "bullmq:build", "runtime:build", "server-express:build"],
      "options": {
        "command": "node scripts/native-consumer-smoke.mjs",
        "cwd": "."
      }
    },
    "test-local-electron": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["example-desktop-electron:build"],
      "options": {
        "command": "node scripts/desktop-consumer-smoke.mjs electron",
        "cwd": "."
      }
    },
    "test-local-tauri": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["example-desktop-tauri:build"],
      "options": {
        "command": "node scripts/desktop-consumer-smoke.mjs tauri",
        "cwd": "."
      }
    },
    "test-runtime-matrix": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["cli:build"],
      "options": {
        "command": "node scripts/local-runtime-matrix.mjs",
        "cwd": "."
      }
    },
    "test-local-node22": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["local:build", "storage-sqlite:build", "cli:build", "create-skein-js:build"],
      "options": {
        "command": "pnpm --package=node@22 --package=npm@11 dlx node scripts/local-consumer-smoke.mjs",
        "cwd": "."
      }
    },
    "pack-scaffolds": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "build",
          "projects": [
            "server-nextjs",
            "langgraph",
            "create-skein-js",
            "core",
            "runtime-redis",
            "server-fastify",
            "config",
            "agent-protocol",
            "telemetry-otel",
            "runtime",
            "storage-postgres",
            "cli",
            "server-nestjs",
            "local",
            "storage-sqlite",
            "server-fetch",
            "nx",
            "telemetry-langsmith",
            "storage-memory",
            "server-kit",
            "telemetry-posthog",
            "server-express",
            "console",
            "channels",
            "example-local-workflow"
          ]
        }
      ],
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/scaffold-packs"],
      "options": {
        "command": "node scripts/scaffold-consumers.mjs pack"
      }
    },
    "scaffold-consumers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/scaffold-consumers.mjs run"
      }
    },
    "prepare-scaffold-managers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/scaffold-consumers.mjs prepare-managers"
      }
    },
    "test-compatibility-consumer": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["server-express:build", "runtime:build", "cli:build", "telemetry-otel:build"],
      "options": {
        "command": "node scripts/compatibility-consumer-smoke.mjs",
        "cwd": "."
      }
    },
    "test-build-image": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["cli:build"],
      "options": {
        "command": "node scripts/build-image-smoke.mjs",
        "cwd": "."
      }
    },
    "test-redis-compatibility": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node scripts/redis-compatibility.mjs",
        "cwd": "."
      }
    },
    "test-runtime-conformance": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["cli:build"],
      "options": {
        "command": "node packages/test-support/scripts/runtime-conformance.mjs --runtime {args.runtime}",
        "cwd": ".",
        "forwardAllArgs": false
      }
    }
  }
}
