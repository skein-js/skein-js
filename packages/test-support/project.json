{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "test-support",
  "sourceRoot": "packages/test-support/src",
  "projectType": "library",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/test-support"
      }
    },
    "test": {
      "dependsOn": [
        "^build",
        "server-express:build",
        "server-fastify:build",
        "server-nestjs:build",
        "server-nextjs:build",
        "server-fetch:build"
      ],
      "inputs": ["default", "^production", "{workspaceRoot}/packages/*/package.json"]
    }
  }
}
