{
  "name": "scaffold",
  "sourceRoot": "packages/scaffold/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-templates"],
      "options": {
        "command": "tsup src/index.ts --format esm --dts --clean",
        "cwd": "packages/scaffold"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/scaffold"
      },
      "dependsOn": ["generate-templates"]
    },
    "generate-templates": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/templates/**/*.tmpl",
        "{projectRoot}/scripts/generate-templates.mjs"
      ],
      "outputs": ["{projectRoot}/src/templates.generated.ts"],
      "options": {
        "command": "node scripts/generate-templates.mjs",
        "cwd": "packages/scaffold"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/examples/express-basic/package.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/scripts/scaffold-cases.json",
        "{workspaceRoot}/packages/nx/src/application-schema.json"
      ],
      "dependsOn": ["generate-templates"]
    }
  }
}
