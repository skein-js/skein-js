{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "cli",
  "sourceRoot": "packages/cli/src",
  "projectType": "library",
  "targets": {
    "test-pnp": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node packages/cli/scripts/test-pnp.mjs",
        "cwd": "."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup src/index.ts --format esm --dts --clean --external vite --external @langchain/langgraph-ui",
        "cwd": "packages/cli"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/cli"
      }
    }
  }
}
