{
  "name": "@skein-js/langgraph",
  "version": "0.16.0",
  "description": "The LangGraph.js binding for @skein-js/agent-protocol — wraps a compiled graph as an AgentGraph.",
  "license": "Apache-2.0",
  "author": "Maina Wycliffe <wmmaina7@gmail.com>",
  "homepage": "https://github.com/skein-js/skein-js/tree/main/packages/langgraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skein-js/skein-js.git",
    "directory": "packages/langgraph"
  },
  "bugs": {
    "url": "https://github.com/skein-js/skein-js/issues"
  },
  "keywords": [
    "typescript",
    "langgraph",
    "agent-protocol",
    "agents",
    "llm",
    "ai"
  ],
  "type": "module",
  "main": "./dist/index.js",
