# Optional app preferences: vertex, gemini, openai, anthropic, or ollama.
MODEL_PROVIDER=vertex

# Vertex AI: Google application default credentials, no project is hardcoded.
# GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Run: gcloud auth application-default login

# Gemini API: MODEL_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_API_KEY= is also accepted.

# OpenAI: MODEL_PROVIDER=openai
# OPENAI_API_KEY=

# Anthropic: MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Ollama: MODEL_PROVIDER=ollama (no API key)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# Run Ollama and install a tool-capable model yourself, for example:
# ollama pull qwen3:8b

# Optional model override. Defaults:
# vertex/gemini: gemini-3-flash-preview; openai: gpt-5-mini;
# anthropic: claude-sonnet-5-5; ollama: qwen3:8b.
# MODEL_NAME=
# Provider-specific GOOGLE_MODEL, OPENAI_MODEL, ANTHROPIC_MODEL and OLLAMA_MODEL also work.
