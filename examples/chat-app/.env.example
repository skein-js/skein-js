# The research agent runs on Gemini. Get a Gemini Developer API key at
# https://aistudio.google.com/apikey, then copy this file to .env and fill it in.

GOOGLE_API_KEY=AIza...

# Optional — override the Gemini model (must support "thinking").
# GOOGLE_MODEL=gemini-2.5-flash

# Optional — enable real web search via Tavily (https://tavily.com). Without it, the web_search
# tool returns a deterministic placeholder so the demo still runs on the Gemini key alone.
# TAVILY_API_KEY=tvly-...

# Optional — trace runs to LangSmith (https://smith.langchain.com/settings). Setting the key is
# enough: skein switches tracing on and groups each thread's runs under one LangSmith Thread.
# Needs `pnpm add @skein-js/langsmith langsmith`. See docs/observability.md.
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=skein-chat-app

# Optional — run analytics and LLM token/cost analytics in PostHog (https://posthog.com, Project
# Settings → Project API Key). Needs `pnpm add @skein-js/posthog posthog-node`.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
