{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@skein-js/core": ["packages/core/src/index.ts"],
      "@skein-js/config": ["packages/config/src/index.ts"],
      "@skein-js/express": ["packages/server-express/src/index.ts"],
      "@skein-js/fastify": ["packages/server-fastify/src/index.ts"],
      "@skein-js/nestjs": ["packages/server-nestjs/src/index.ts"],
      "@skein-js/nextjs": ["packages/server-nextjs/src/index.ts"],
      "@skein-js/server-kit": ["packages/server-kit/src/index.ts"],
      "@skein-js/storage-memory": ["packages/storage-memory/src/index.ts"],
      "@skein-js/storage-postgres": ["packages/storage-postgres/src/index.ts"],
      "@skein-js/redis": ["packages/runtime-redis/src/index.ts"],
      "@skein-js/agent-protocol": ["packages/agent-protocol/src/index.ts"],
      "@skein-js/runtime": ["packages/runtime/src/index.ts"],
      "@skein-js/langsmith": ["packages/telemetry-langsmith/src/index.ts"],
      "@skein-js/posthog": ["packages/telemetry-posthog/src/index.ts"],
      "@skein-js/otel": ["packages/telemetry-otel/src/index.ts"],
      "@skein-js/bench": ["packages/bench/src/index.ts"],
      "@skein-js/fetch": ["packages/server-fetch/src/index.ts"],
      "@skein-js/console": ["packages/console/src/index.ts"],
      "@skein-js/langgraph": ["packages/langgraph/src/index.ts"],
      "@skein-js/channels": ["packages/channels/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
