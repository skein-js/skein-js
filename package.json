{
  "name": "@skein-js/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "skein-js — the open-source, self-hosted server runtime for LangGraph.js agents in TypeScript, and an alternative to LangGraph Platform.",
  "homepage": "https://github.com/skein-js/skein-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skein-js/skein-js.git"
  },
  "bugs": {
    "url": "https://github.com/skein-js/skein-js/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test-integration",
    "test:coverage": "nx run-many -t test --coverage",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "docs:llms": "node scripts/generate-llms-full.mjs",
    "docs:og": "node scripts/generate-og.mjs",
    "docs:logo": "node scripts/generate-logo.mjs",
    "docs:dev": "nx dev docs",
    "docs:build": "nx build docs",
    "docs:preview": "nx preview docs",
    "migrations:generate": "nx run storage-postgres:generate-migrations",
    "affected": "nx affected -t lint test typecheck build",
    "release": "nx release --skip-publish",
    "release:dry-run": "nx release --skip-publish --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nx/eslint": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/web": "23.2.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jiti": "2.4.2",
    "mermaid": "^11.16.1",
    "nx": "23.2.1",
    "prettier": "^3.9.6",
    "testcontainers": "^11.14.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "8.1.6",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "4.1.11",
    "vue": "^3.5.44"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "axios@>=1 <1.20.0": "^1.20.0",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@>=1 <1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=5 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "body-parser@>=2 <2.4.0": "^2.4.0",
      "dompurify@<3.4.16": "^3.4.16",
      "esbuild@<0.28.2": "^0.28.2",
      "fast-uri@>=3 <3.1.8": "^3.1.8",
      "fast-uri@>=4 <4.1.5": "^4.1.5",
      "find-my-way@>=9 <9.7.0": "^9.7.0",
      "follow-redirects@>=1 <1.16.1": "^1.16.1",
      "hono@>=4 <4.13.7": "^4.13.7",
      "http-cache-semantics@>=4 <4.3.0": "^4.3.0",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "mermaid>katex": "^0.18.2",
      "multer@>=2 <2.5.0": "^2.5.0",
      "nanoid@>=3 <3.3.18": "^3.3.18",
      "next@15>postcss": "^8.5.23",
      "piscina@>=4 <4.9.4": "^4.9.4",
      "postcss@>=8 <8.5.23": "^8.5.23",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "protobufjs@>=7 <7.6.5": "^7.6.5",
      "proxy-addr@>=2 <2.0.8": "^2.0.8",
      "qs@>=6 <6.16.0": "^6.16.0",
      "smol-toml@>=1 <1.9.0": "^1.9.0",
      "source-map-js@>=1 <1.2.2": "^1.2.2",
      "svgo@>=3 <3.3.5": "^3.3.5",
      "vitepress>vite": "^6.4.4",
      "vite@>=8 <8.1.6": "^8.1.6",
      "@vitejs/plugin-vue@5>vite": "^6.4.4",
      "dockerode@4>uuid": "^11.1.1",
      "next@15>sharp": "^0.35.5",
