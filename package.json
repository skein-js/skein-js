{
  "name": "@skein-js/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "skein-js — the open-source alternative to LangGraph Platform for TypeScript: a self-hosted Agent Protocol server for LangGraph.js, and a drop-in for the LangGraph CLI.",
  "homepage": "https://github.com/skein-js/skein-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skein-js/skein-js.git"
  },
  "bugs": {
    "url": "https://github.com/skein-js/skein-js/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint --fix",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t test-integration",
    "test:coverage": "nx run-many -t test --coverage",
    "format": "nx format:write --all",
    "format:check": "nx format:check --all",
    "docs:llms": "node scripts/generate-llms-full.mjs",
    "docs:og": "node scripts/generate-og.mjs",
    "docs:logo": "node scripts/generate-logo.mjs",
    "docs:dev": "nx dev docs",
    "docs:build": "nx build docs",
    "docs:preview": "nx preview docs",
    "migrations:generate": "nx run storage-postgres:generate-migrations",
    "affected": "nx affected -t lint test typecheck build",
    "release": "nx release --skip-publish",
    "release:dry-run": "nx release --skip-publish --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nx/eslint": "23.0.2",
    "@nx/js": "23.0.2",
    "@nx/react": "23.0.2",
    "@nx/vite": "23.0.2",
    "@nx/vitest": "23.0.2",
    "@nx/web": "23.0.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jiti": "2.4.2",
    "nx": "23.0.2",
    "prettier": "^3.9.6",
    "testcontainers": "^10.16.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "8.1.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-tabs": "^0.9.1",
    "vitest": "4.1.9",
    "vue": "^3.5.41"
  }
}
